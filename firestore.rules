rules_version = '2';

service cloud.firestore {
  // Helper to check role
  function isSuperAdmin() {
    return request.auth.token.role == 'superAdmin' || request.auth.token.role == 'SUPER_ADMIN' || request.auth.token.email == 'danielkiboko218@gmail.com';
  }
  function isAdmin() {
    return request.auth.token.role == 'admin' || request.auth.token.role == 'ADMIN' || request.auth.token.role == 'SUB_ADMIN' || isSuperAdmin();
  }
  function isSupplier() {
    return request.auth.token.role == 'supplier' || request.auth.token.role == 'SUPPLIER' || request.auth.token.role == 'SUPPLIER_IMMO';
  }
  function isSubSupplier() {
    return request.auth.token.role == 'SUB_SUPPLIER' || request.auth.token.role == 'sub_supplier';
  }
  function ownsSupplierData(supplierId) {
    return (isSupplier() && request.auth.uid == supplierId) ||
           (isSubSupplier() && request.auth.token.parentSupplierId == supplierId);
  }
  function isDriver() {
    return request.auth.token.role == 'driver' || request.auth.token.role == 'DRIVER';
  }

  match /databases/{database}/documents {
    // Suppliers can manage their own supplier document
    match /suppliers/{supplierId} {
      allow read, write: if isSuperAdmin() || isAdmin() || (
        ownsSupplierData(supplierId)
      );
    }

    // Drivers collection – top‑level with supplierId field
    match /drivers/{driverId} {
      // Creation allowed for a supplier creating its own driver
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      // Supplier can read/write its drivers, admin/superadmin can manage all, driver can manage own
      allow read, update, delete: if (
        isSuperAdmin() || isAdmin() || (
          ownsSupplierData(resource.data.supplierId)
        ) || (
          isDriver() && request.auth.uid == driverId
        )
      );
    }

    // Orders collection – each order contains supplierId and optional driverId
    match /orders/{orderId} {
      // Suppliers and admins can create orders for their supplier
      allow create: if isSuperAdmin() || isAdmin() || (
        ownsSupplierData(request.resource.data.supplierId)
      );

      // Read/write for the supplier that owns the order
      allow read, update, delete: if (
        isSuperAdmin() || isAdmin() || (
          ownsSupplierData(resource.data.supplierId)
        )
      );

      // Drivers can read the order assigned to them and optionally update status
      allow read: if isDriver() && resource.data.driverId == request.auth.uid;
      allow update: if isDriver() && request.resource.data.driverId == request.auth.uid &&
                     request.auth.uid == resource.data.driverId;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read, write: if isSuperAdmin() || isAdmin();
      allow read, update: if ownsSupplierData(resource.data.parentSupplierId);
    }

    // Chats collection
    match /chats/{chatId} {
      allow read, update: if request.auth != null && (
        resource.data.clientId == request.auth.uid || 
        ownsSupplierData(resource.data.supplierId) ||
        isSuperAdmin() || isAdmin()
      );
      allow create: if request.auth != null; 

      match /messages/{messageId} {
        allow read, write: if request.auth != null && (
          get(/databases/$(database)/documents/chats/$(chatId)).data.clientId == request.auth.uid ||
          ownsSupplierData(get(/databases/$(database)/documents/chats/$(chatId)).data.supplierId) ||
          isSuperAdmin() || isAdmin()
        );
      }
    }

    // Add additional collections (products, etc.) with similar scoping if needed.
    match /products/{productId} {
      allow read: if true;
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow update, delete: if ownsSupplierData(resource.data.supplierId);
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /invoices/{invoiceId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /properties/{propertyId} {
      allow read: if true; // Public can see properties
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow update, delete: if ownsSupplierData(resource.data.supplierId);
      allow update, delete: if isSuperAdmin() || isAdmin();
    }

    match /tenants/{tenantId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /payments/{paymentId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /visits/{visitId} {
      allow create: if true; // Public can request a visit
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /error_logs/{logId} {
      allow create: if true; // Anyone can generate an error log
      allow read, update, delete: if isSuperAdmin() || isAdmin();
    }

    match /transactions/{transactionId} {
      allow read, write: if isSuperAdmin() || isAdmin();
    }
    match /supplier_transactions/{transactionId} {
      allow create: if ownsSupplierData(request.resource.data.supplierId);
      allow read, update, delete: if ownsSupplierData(resource.data.supplierId);
      allow read, write: if isSuperAdmin() || isAdmin();
    }

    match /notifications/{notifId} {
      allow create: if isSuperAdmin() || isAdmin();
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /inapp_notifications/{notifId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isSuperAdmin() || isAdmin() || (
        ownsSupplierData(resource.data.supplierId)
      ) || (
        request.auth != null && resource.data.userId == request.auth.uid
      );
    }
  }
}
